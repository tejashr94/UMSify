<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml
    Main activity layout: full-screen WebView with an overlay progress bar
    and an error state layout shown when the network is unavailable.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- WebView — takes the full screen -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Page load progress bar — shown at the top while the page is loading -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="top"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/colorAccent"
        android:progressBackgroundTint="@color/colorBackground"
        android:visibility="invisible" />

    <!-- Error state — shown when there is no internet connection -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        android:background="@color/colorBackground">

        <!-- Error icon -->
        <ImageView
            android:id="@+id/ivErrorIcon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_no_internet"
            android:contentDescription="@string/error_no_internet_title"
            android:alpha="0.7" />

        <!-- Error title -->
        <TextView
            android:id="@+id/tvErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/error_no_internet_title"
            android:textColor="@color/colorOnSurface"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center" />

        <!-- Error message -->
        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/error_no_internet_message"
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4" />

        <!-- Retry button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/btn_retry"
            android:textColor="#FFFFFF"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            app:backgroundTint="@color/colorAccent"
            app:cornerRadius="24dp"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
